# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.eggs/

# Virtual envs
.venv/
venv/
env/

# Tooling / IDE
.idea/
.vscode/
.DS_Store
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local env / secrets (never commit)
.env
.env.*
!.env.example

# Local data / scratch
*.local.json
scratch/

# Vendored core (core/) is committed as SOURCE ONLY — ignore any build artifacts
# produced by building it locally (the Docker image builds it in an isolated stage).
core/**/*.so
core/**/*.c
core/**/*.html
core/build/
core/**/*.egg-info/
