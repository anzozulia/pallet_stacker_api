# Copy to .env and adjust. All settings are optional (defaults shown).
PALLET_API_REDIS_URL=redis://localhost:6379
# Version strings surfaced by GET /version. CORE_VERSION reports the vendored
# pallet_packer core (see core/VENDOR.md).
PALLET_API_VERSION=0.1.0
PALLET_API_CORE_VERSION=vendored
PALLET_API_MAX_BOXES=500
# Request-body byte cap (413 over it); a legit 500-box request is ~few hundred KB.
PALLET_API_MAX_BODY_BYTES=10485760
PALLET_API_SOFT_BUDGET_S=90
PALLET_API_HARD_BUDGET_S=120
PALLET_API_RESULT_TTL_S=3600
PALLET_API_DEFAULT_MAX_PALLETS=1
PALLET_API_DEFAULT_SEED=42
PALLET_API_RATE_LIMIT_PER_MIN=30
# Solver knobs
PALLET_API_POPULATION_SIZE=300
PALLET_API_N_POPULATIONS=3
PALLET_API_PATIENCE=150
PALLET_API_N_MODES=6
# Realism layer (D14) — kill-switches, all ON by default. RECENTER centres the
# finished load on the deck; ALIGN_ORIENTATIONS unifies same-SKU rotations per
# layer; REALISM_WEIGHT scales the heavy-low/anti-tower fitness term (0 = off).
PALLET_API_RECENTER=1
PALLET_API_ALIGN_ORIENTATIONS=1
PALLET_API_REALISM_WEIGHT=1.0
# Transitive load bearing (round 2, F19): weights propagate down the whole
# stack against max_load_on_top. Physically correct; fragile stacked loads
# pack fewer boxes than the old direct-only model. 0 = old behavior.
PALLET_API_TRANSITIVE_LOAD=1
# Per-worker OpenMP threads (set on the worker process; see docs/01_architecture.md)
OMP_NUM_THREADS=2
