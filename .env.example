# Copy to .env and adjust. All settings are optional (defaults shown).
PALLET_API_REDIS_URL=redis://localhost:6379
# Version strings surfaced by GET /version. CORE_VERSION reports the vendored
# pallet_packer core (see core/VENDOR.md).
PALLET_API_VERSION=0.1.0
PALLET_API_CORE_VERSION=vendored
PALLET_API_MAX_BOXES=500
PALLET_API_SOFT_BUDGET_S=90
PALLET_API_HARD_BUDGET_S=120
PALLET_API_RESULT_TTL_S=3600
PALLET_API_DEFAULT_MAX_PALLETS=1
PALLET_API_DEFAULT_SEED=42
PALLET_API_RATE_LIMIT_PER_MIN=30
# CORS: origins allowed to call this API from a browser (the static front-end does).
# Comma-separated; "*" allows any origin (safe — this API is no-login, no cookies).
# Lock down in production, e.g. PALLET_API_CORS_ORIGINS=https://app.example.com
PALLET_API_CORS_ORIGINS=*
# Solver knobs
PALLET_API_POPULATION_SIZE=300
PALLET_API_N_POPULATIONS=3
PALLET_API_PATIENCE=150
PALLET_API_N_MODES=6
# Per-worker OpenMP threads (set on the worker process; see docs/01_architecture.md)
OMP_NUM_THREADS=2
